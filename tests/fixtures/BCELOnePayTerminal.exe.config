<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="BCELOnePayTerminal.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
    </startup>
    <applicationSettings>
        <BCELOnePayTerminal.Properties.Settings>
            <setting name="CefSharpUrl" serializeAs="String">
                <!-- <value>http://localhost:5173</value> -->
                <value>https://dev.example.invalid/</value>

            </setting>
            <setting name="CefSharpRemoteDebuggingPort" serializeAs="String">
                <value>9999</value>
            </setting>
            <setting name="Topmost" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="SerialPortName" serializeAs="String">
                <value>COM2</value>
            </setting>
            <setting name="LogServerUrl" serializeAs="String">
                <value />
            </setting>
            <setting name="TerminalId" serializeAs="String">
                <value>FAKE-T09</value>
            </setting>
            <setting name="ClientSetting" serializeAs="String">
                <value>{
					"staticQrId": "fakeqr0001",
                    "terminalId": "FAKE-T09",
                    "serialPortName": "COM2",
                    "volume": 7,
				}</value>
            </setting>
        </BCELOnePayTerminal.Properties.Settings>
    </applicationSettings>
</configuration>    
